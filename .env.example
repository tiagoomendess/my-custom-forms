# MySQL connection string (used by the app and drizzle-kit).
DATABASE_URL="mysql://root:rootpassword@localhost:3306/my_custom_forms"

# Admin area password and cookie signing secret.
ADMIN_PASSWORD=password
SESSION_SECRET=secret

# Optional: directory for uploaded images (default: data/uploads).
# UPLOAD_DIR=data/uploads

# Optional: HTTP listen settings for `npm run start` (defaults shown).
# PORT=3000
# HOST=0.0.0.0

# Max request body size for the Node adapter (default is 512K, too small for image uploads).
# Must be at least the app upload limit (5 MB).
BODY_SIZE_LIMIT=5M

# Behind a reverse proxy (nginx) + Cloudflare: read the real client IP from a trusted header.
# Without this, getClientAddress() returns 127.0.0.1 (the nginx → Node connection).
# CF-Connecting-IP is set by Cloudflare; nginx must forward it (see deployment notes).
ADDRESS_HEADER=cf-connecting-ip

# Alternative if not using Cloudflare (or CF-Connecting-IP is unavailable):
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=2
