# Local MySQL connection string. Used by drizzle-kit (migrations / studio) AND,
# during local dev, fed to the Hyperdrive binding (see vite.config.ts) so the
# Worker connects to your local database without committing credentials.
# In production the Worker uses the deployed Hyperdrive config (id in wrangler.jsonc).
DATABASE_URL="mysql://root:rootpassword@localhost:3306/my_custom_forms"
ADMIN_PASSWORD=password
SESSION_SECRET=secret